{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "linkwarden-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "LINKWARDEN_MCP",
				"class_name": "LinkwardenMCP"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"LinkwardenMCP"
			]
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "9f593cf9ad3846428e188bc38dd2eba4",
			"preview_id": "9f593cf9ad3846428e188bc38dd2eba4"
		}
	],
	"r2_buckets": [
		{
			"binding": "SINK_BUCKET",
			"bucket_name": "ai-search-sink"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"AI_SEARCH_INSTANCE": "personal-search"
	},
	"workers_dev": true,
	"routes": [
		{ "pattern": "linkwarden-mcp.crunchypancake.com", "custom_domain": true }
	],
 "triggers": {
		"crons": [
			"0 * * * *"
		]
	},
 "observability": {
  "logs": {
   "enabled": true,
    "invocation_logs": true
  }
 }
}