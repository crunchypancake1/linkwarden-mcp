{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linkwarden-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LINKWARDEN_MCP",
        "class_name": "LinkwardenMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LinkwardenMCP"
      ]
    }
  ],
  "vars": {
    "LINKWARDEN_URL": "http://mediaserver:9000"
  },
  "vpc_services": [
    {
      "binding": "LINKWARDEN_VPC",
      "service_id": "01a0203c-baee-7381-bcb5-964ffff962f6",
      "remote": true
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "LINKWARDEN_TOKEN",
      "store_id": "d947ac5bb8ef4800ac46fc59128a1a09",
      "secret_name": "linkwarden-token"
    }
  ],
  "workers_dev": false,
  "routes": [
    { "pattern": "linkwarden.crunchypancake.com/mcp", "zone_name": "crunchypancake.com" }
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
